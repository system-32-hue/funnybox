--made by system
local Players = game:GetService("Players")
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Criar RemoteEvent para enviar objetos ao servidor
local remoteEvent = Instance.new("RemoteEvent")
remoteEvent.Name = "AssetSpawner"
remoteEvent.Parent = ReplicatedStorage

-- Script do servidor (injetado via executor)
local serverScript = Instance.new("Script")
serverScript.Name = "AssetSpawnerServer"
serverScript.Source = [[
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remoteEvent = ReplicatedStorage:WaitForChild("AssetSpawner")

remoteEvent.OnServerEvent:Connect(function(player, objects)
    if not objects or #objects == 0 then return end
    
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    
    local spawnCF = CFrame.new(0, 50, 0)
    if root then
        spawnCF = root.CFrame * CFrame.new(0, 0, -12)
    end
    
    -- Spawnar cada objeto no workspace (visível para TODOS)
    for _, obj in ipairs(objects) do
        if obj:IsA("Tool") then
            obj.Parent = player:WaitForChild("Backpack")
        else
            obj.Parent = workspace
            if obj:IsA("Model") then
                pcall(function()
                    obj:PivotTo(spawnCF)
                end)
            elseif obj:IsA("BasePart") then
                obj.CFrame = spawnCF
            end
        end
    end
end)
]]
serverScript.Parent = ReplicatedStorage

