local Players = game:GetService("Players")
local player = Players.LocalPlayer
local backpack = player:WaitForChild("Backpack")
local playerGui = player:WaitForChild("PlayerGui")

local tool = Instance.new("Tool")
tool.Name = "DO IT!"
tool.RequiresHandle = false
tool.CanBeDropped = false
tool.Parent = backpack

local gui
local isBusy = false

local function getCharacter(name)
	return workspace:FindFirstChild(name)
end

local function fWeld(name, parent, part0, part1, useC0, a, b, c, d, e, f)
	local w = Instance.new("Weld")
	w.Name = name
	w.Parent = parent
	w.Part0 = part0
	w.Part1 = part1
	if useC0 then
		w.C0 = CFrame.new(a, b, c) * CFrame.Angles(d, e, f)
	else
		w.C1 = CFrame.new(a, b, c) * CFrame.Angles(d, e, f)
	end
	return w
end

local function clearOldWelds(torso)
	for _, name in ipairs({"Left Shoulder", "Right Shoulder", "Left Hip", "Right Hip", "weldx"}) do
		local old = torso:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
end

local function fun(name1, name2)
	if isBusy then return end
	isBusy = true

	local char1 = getCharacter(name1)
	local char2 = getCharacter(name2)

	if not char1 or not char2 then
		isBusy = false
		return
	end

	local t1 = char1:FindFirstChild("Torso")
	local t2 = char2:FindFirstChild("Torso")
	if not t1 or not t2 then
		isBusy = false
		return
	end

	local leftArm1 = char1:FindFirstChild("Left Arm")
	local rightArm1 = char1:FindFirstChild("Right Arm")
	local leftArm2 = char2:FindFirstChild("Left Arm")
	local rightArm2 = char2:FindFirstChild("Right Arm")
	local leftLeg2 = char2:FindFirstChild("Left Leg")
	local rightLeg2 = char2:FindFirstChild("Right Leg")

	if not (leftArm1 and rightArm1 and leftArm2 and rightArm2 and leftLeg2 and rightLeg2) then
		isBusy = false
		return
	end

	local humanoid2 = char2:FindFirstChildOfClass("Humanoid")
	if humanoid2 then
		humanoid2.PlatformStand = true
		humanoid2.AutoRotate = false
	end

	-- Limpa welds antigos
	clearOldWelds(t1)
	clearOldWelds(t2)

	-- Prepara braços do player
	leftArm1.Anchored = false
	rightArm1.Anchored = false
	leftArm1.CanCollide = false
	rightArm1.CanCollide = false
	leftArm1.Massless = true
	rightArm1.Massless = true

	local ls1 = Instance.new("Weld")
	ls1.Name = "Left Shoulder"
	ls1.Parent = t1
	ls1.Part0 = t1
	ls1.Part1 = leftArm1
	ls1.C0 = CFrame.new(-1.5, 0, 0)
	ls1.C1 = CFrame.new(-0.5, 0.7, 0) * CFrame.Angles(-0.9, -0.4, 0)

	local rs1 = Instance.new("Weld")
	rs1.Name = "Right Shoulder"
	rs1.Parent = t1
	rs1.Part0 = t1
	rs1.Part1 = rightArm1
	rs1.C0 = CFrame.new(1.5, 0, 0)
	rs1.C1 = CFrame.new(0.5, 0.7, 0) * CFrame.Angles(-0.9, 0.4, 0)

	-- Braços e pernas do alvo
	local ls2 = Instance.new("Weld")
	ls2.Name = "Left Shoulder"
	ls2.Parent = t2
	ls2.Part0 = t2
	ls2.Part1 = leftArm2
	ls2.C0 = CFrame.new(-1.5, 0, 0)

	local rs2 = Instance.new("Weld")
	rs2.Name = "Right Shoulder"
	rs2.Parent = t2
	rs2.Part0 = t2
	rs2.Part1 = rightArm2
	rs2.C0 = CFrame.new(1.5, 0, 0)

	local lh2 = Instance.new("Weld")
	lh2.Name = "Left Hip"
	lh2.Parent = t2
	lh2.Part0 = t2
	lh2.Part1 = leftLeg2
	lh2.C0 = CFrame.new(-0.5, -2, 0)

	local rh2 = Instance.new("Weld")
	rh2.Name = "Right Hip"
	rh2.Parent = t2
	rh2.Part0 = t2
	rh2.Part1 = rightLeg2
	rh2.C0 = CFrame.new(0.5, -2, 0)

	-- ===== PARTES EXPLÍCITAS =====
	local function createPart(name, parent, size, color, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = false
		p.Massless = true
		p.BrickColor = BrickColor.new(color)
		p.Size = size
		p.Parent = parent
		if shape == "Ball" then
			p.Shape = Enum.PartType.Ball
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		elseif shape == "Cylinder" then
			local mesh = Instance.new("CylinderMesh")
			mesh.Parent = p
		end
		return p
	end

	-- Bolas do player
	local d = createPart("tester", t1, Vector3.new(1, 1, 1), "Pastel", "Ball")
	d.Mesh.Scale = Vector3.new(0.4, 0.4, 0.4)
	fWeld("weld", t1, t1, d, true, -0.2, -1.3, -0.6, 0, 0, 0)

	local d2 = d:Clone()
	d2.Parent = t1
	fWeld("weld", t1, t1, d2, true, 0.2, -1.3, -0.6, 0, 0, 0)

	-- Eixo
	local c = createPart("1", t1, Vector3.new(0.4, 1.3, 0.4), "Pastel brown", "Cylinder")
	fWeld("weld", t1, t1, c, true, 0, -1, -0.52 - (c.Size.Y / 2), math.rad(-80), 0, 0)

	local c2 = d:Clone()
	c2.Name = "dclone"
	c2.BrickColor = BrickColor.new("Pink")
	c2.Mesh.Scale = Vector3.new(0.4, 0.62, 0.4)
	c2.Parent = t1
	fWeld("weld", t1, c, c2, true, 0, c.Size.Y / 2, 0, math.rad(-10), 0, 0)

	-- Seios do alvo
	local bl = createPart("bl", t2, Vector3.new(1, 1, 1), "Pastel brown", "Ball")
	bl.Mesh.Scale = Vector3.new(1.2, 1.2, 1.2)
	fWeld("weld", t2, t2, bl, true, -0.5, 0.5, -0.6, 0, 0, 0)

	local br = createPart("brazil", t2, Vector3.new(1, 1, 1), "Pastel brown", "Ball")
	br.Mesh.Scale = Vector3.new(1.2, 1.2, 1.2)
	fWeld("weld", t2, t2, br, true, 0.5, 0.5, -0.6, 0, 0, 0)

	-- Mamilos
	local bln = createPart("burn1", t2, Vector3.new(1, 1, 1), "Pink", "Ball")
	bln.Mesh.Scale = Vector3.new(0.2, 0.2, 0.2)
	fWeld("weld", t2, t2, bln, true, -0.5, 0.5, -1.2, 0, 0, 0)

	local brn = createPart("tester2", t2, Vector3.new(1, 1, 1), "Pink", "Ball")
	brn.Mesh.Scale = Vector3.new(0.2, 0.2, 0.2)
	fWeld("weld", t2, t2, brn, true, 0.5, 0.5, -1.2, 0, 0, 0)

	-- Poses finais
	lh2.C1 = CFrame.new(0, -1.5, -0.5) * CFrame.Angles(0.9, -0.4, 0)
	rh2.C1 = CFrame.new(0, -1.5, -0.5) * CFrame.Angles(0.9, 0.4, 0)
	ls2.C1 = CFrame.new(-0.5, -1.3, -0.5) * CFrame.Angles(0.9, -0.4, 0)
	rs2.C1 = CFrame.new(0.5, -1.3, -0.5) * CFrame.Angles(0.9, 0.4, 0)

	local we = fWeld("weldx", t1, t1, t2, true, 0, -0.9, -1.3, math.rad(-90), 0, 0)

	local neck = t2:FindFirstChild("Neck")
	if neck then
		neck.C0 = CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(-210), math.rad(180), 0)
	end

	-- Animação de movimento
	task.spawn(function()
		while we and we.Parent and t1.Parent and t2.Parent do
			for _ = 1, 6 do
				if not (we and we.Parent) then break end
				we.C1 = we.C1 * CFrame.new(0, -0.3, 0)
				task.wait()
			end
			for _ = 1, 6 do
				if not (we and we.Parent) then break end
				we.C1 = we.C1 * CFrame.new(0, 0.3, 0)
				task.wait()
			end
		end
		isBusy = false
	end)
end

local function getTargets()
	local targets = {}

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			table.insert(targets, {
				Name = plr.Name,
				Model = plr.Character,
				Type = "PLAYER"
			})
		end
	end

	for _, model in ipairs(workspace:GetChildren()) do
		if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") then
			local isPlayer = false
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr.Character == model then
					isPlayer = true
					break
				end
			end
			if not isPlayer and model ~= player.Character then
				table.insert(targets, {
					Name = model.Name,
					Model = model,
					Type = "NPC"
				})
			end
		end
	end

	return targets
end

local function createGui()
	if gui then
		gui:Destroy()
	end

	gui = Instance.new("ScreenGui")
	gui.Name = "SignPlayerSelector"
	gui.ResetOnSpawn = false
	gui.Parent = playerGui

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 320, 0, 430)
	frame.Position = UDim2.new(0.5, -160, 0.5, -215)
	frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	frame.BorderSizePixel = 0
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -55, 0, 55)
	title.BackgroundTransparency = 1
	title.Text = "SELECT PLAYER / NPC"
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextScaled = true
	title.Font = Enum.Font.GothamBold
	title.Parent = frame

	local close = Instance.new("TextButton")
	close.Size = UDim2.new(0, 40, 0, 40)
	close.Position = UDim2.new(1, -45, 0, 7)
	close.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	close.Text = "X"
	close.TextColor3 = Color3.new(1, 1, 1)
	close.TextScaled = true
	close.Font = Enum.Font.GothamBold
	close.Parent = frame

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 6)
	closeCorner.Parent = close

	close.Activated:Connect(function()
		if gui then
			gui:Destroy()
			gui = nil
		end
	end)

	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, -20, 1, -70)
	list.Position = UDim2.new(0, 10, 0, 60)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.Parent = frame

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.Parent = list

	local targets = getTargets()

	for _, target in ipairs(targets) do
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, -5, 0, 45)
		button.BackgroundColor3 = target.Type == "NPC"
			and Color3.fromRGB(75, 55, 95)
			or Color3.fromRGB(55, 55, 55)
		button.TextColor3 = Color3.new(1, 1, 1)
		button.Text = target.Type == "NPC"
			and "[NPC] " .. target.Name
			or "[PLAYER] " .. target.Name
		button.TextScaled = true
		button.Font = Enum.Font.Gotham
		button.Parent = list

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 6)
		btnCorner.Parent = button

		button.Activated:Connect(function()
			if player.Character and target.Model and target.Model.Parent then
				fun(player.Name, target.Model.Name)
			end
			if gui then
				gui:Destroy()
				gui = nil
			end
		end)
	end

	task.wait()
	list.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
end

tool.Equipped:Connect(createGui)

tool.Unequipped:Connect(function()
	if gui then
		gui:Destroy()
		gui = nil
	end
end)

player.CharacterAdded:Connect(function()
	task.wait(1)
	if tool.Parent ~= backpack and tool.Parent ~= player.Character then
		tool.Parent = backpack
	end
end)
