local gui

local function getNPC(name)
	return workspace:FindFirstChild(name)
end

local function fWeld(zName, zParent, zPart0, zPart1, zCoco, a, b, c, d, e, f)
	local funcw = Instance.new("Weld")
	funcw.Name = zName
	funcw.Parent = zParent
	funcw.Part0 = zPart0
	funcw.Part1 = zPart1

	if zCoco == true then
		funcw.C0 = CFrame.new(a, b, c) * CFrame.fromEulerAnglesXYZ(d, e, f)
	else
		funcw.C1 = CFrame.new(a, b, c) * CFrame.fromEulerAnglesXYZ(d, e, f)
	end

	return funcw
end

local function fun(n1, n2)
	local char1 = getNPC(n1)
	local char2 = getNPC(n2)

	if not char1 or not char2 then
		return
	end

	local t1 = char1:FindFirstChild("Torso")
	local t2 = char2:FindFirstChild("Torso")

	if not t1 or not t2 then
		return
	end

	local leftArm1 = char1:FindFirstChild("Left Arm")
	local rightArm1 = char1:FindFirstChild("Right Arm")

	local leftArm2 = char2:FindFirstChild("Left Arm")
	local rightArm2 = char2:FindFirstChild("Right Arm")
	local leftLeg2 = char2:FindFirstChild("Left Leg")
	local rightLeg2 = char2:FindFirstChild("Right Leg")

	if not leftArm1 or not rightArm1 then
		return
	end

	if not leftArm2 or not rightArm2 or not leftLeg2 or not rightLeg2 then
		return
	end

	local humanoid2 = char2:FindFirstChildOfClass("Humanoid")

	if humanoid2 then
		humanoid2.PlatformStand = true
		humanoid2.AutoRotate = false
	end

	local old = t1:FindFirstChild("Left Shoulder")
	if old then
		old:Destroy()
	end

	old = t1:FindFirstChild("Right Shoulder")
	if old then
		old:Destroy()
	end

	leftArm1.Anchored = false
	rightArm1.Anchored = false

	leftArm1.CanCollide = false
	rightArm1.CanCollide = false

	leftArm1.Massless = true
	rightArm1.Massless = true

	local ls1 = Instance.new("Weld")
	ls1.Name = "Left Shoulder"
	ls1.Parent = t1
	ls1.Part0 = t1
	ls1.Part1 = leftArm1
	ls1.C0 = CFrame.new(-1.5, 0, 0)
	ls1.C1 =
		CFrame.new(-0.5, 0.7, 0) *
		CFrame.Angles(-0.9, -0.4, 0)

	local rs1 = Instance.new("Weld")
	rs1.Name = "Right Shoulder"
	rs1.Parent = t1
	rs1.Part0 = t1
	rs1.Part1 = rightArm1
	rs1.C0 = CFrame.new(1.5, 0, 0)
	rs1.C1 =
		CFrame.new(0.5, 0.7, 0) *
		CFrame.Angles(-0.9, 0.4, 0)

	old = t2:FindFirstChild("Left Shoulder")
	if old then
		old:Destroy()
	end

	local ls2 = Instance.new("Weld")
	ls2.Parent = t2
	ls2.Part0 = t2
	ls2.Part1 = leftArm2
	ls2.C0 = CFrame.new(-1.5, 0, 0)
	ls2.Name = "Left Shoulder"

	old = t2:FindFirstChild("Right Shoulder")
	if old then
		old:Destroy()
	end

	local rs2 = Instance.new("Weld")
	rs2.Parent = t2
	rs2.Part0 = t2
	rs2.Part1 = rightArm2
	rs2.C0 = CFrame.new(1.5, 0, 0)
	rs2.Name = "Right Shoulder"

	old = t2:FindFirstChild("Left Hip")
	if old then
		old:Destroy()
	end

	local lh2 = Instance.new("Weld")
	lh2.Parent = t2
	lh2.Part0 = t2
	lh2.Part1 = leftLeg2
	lh2.C0 = CFrame.new(-0.5, -2, 0)
	lh2.Name = "Left Hip"

	old = t2:FindFirstChild("Right Hip")
	if old then
		old:Destroy()
	end

	local rh2 = Instance.new("Weld")
	rh2.Parent = t2
	rh2.Part0 = t2
	rh2.Part1 = rightLeg2
	rh2.C0 = CFrame.new(0.5, -2, 0)
	rh2.Name = "Right Hip"

	local d = Instance.new("Part")
	d.Name = "tester"
	d.TopSurface = 0
	d.BottomSurface = 0
	d.CanCollide = false
	d.BrickColor = BrickColor.new("Pastel")
	d.Shape = Enum.PartType.Ball
	d.Parent = t1
	d.Size = Vector3.new(1, 1, 1)
	d.Massless = true

	local dm = Instance.new("SpecialMesh")
	dm.MeshType = Enum.MeshType.Sphere
	dm.Parent = d
	dm.Scale = Vector3.new(0.4, 0.4, 0.4)

	fWeld(
		"weld",
		t1,
		t1,
		d,
		true,
		-0.2,
		-1.3,
		-0.6,
		0,
		0,
		0
	)

	local d2 = d:Clone()
	d2.Parent = t1

	fWeld(
		"weld",
		t1,
		t1,
		d2,
		true,
		0.2,
		-1.3,
		-0.6,
		0,
		0,
		0
	)

	local c = Instance.new("Part")
	c.Name = "1"
	c.TopSurface = 0
	c.BottomSurface = 0
	c.CanCollide = false
	c.BrickColor = BrickColor.new("Pastel brown")
	c.Parent = t1
	c.Size = Vector3.new(0.4, 1.3, 0.4)
	c.Massless = true

	local cm = Instance.new("CylinderMesh")
	cm.Parent = c

	fWeld(
		"weld",
		t1,
		t1,
		c,
		true,
		0,
		-1,
		-0.52 - (c.Size.Y / 2),
		math.rad(-80),
		0,
		0
	)

	local c2 = d:Clone()
	c2.Name = "dclone"
	c2.BrickColor = BrickColor.new("Pink")
	c2.Mesh.Scale = Vector3.new(0.4, 0.62, 0.4)
	c2.Parent = t1

	fWeld(
		"weld",
		t1,
		c,
		c2,
		true,
		0,
		c.Size.Y / 2,
		0,
		math.rad(-10),
		0,
		0
	)

	local bl = Instance.new("Part")
	bl.Name = "bl"
	bl.TopSurface = 0
	bl.BottomSurface = 0
	bl.CanCollide = false
	bl.BrickColor = BrickColor.new("Pastel brown")
	bl.Shape = Enum.PartType.Ball
	bl.Parent = t2
	bl.Size = Vector3.new(1, 1, 1)
	bl.Massless = true

	local dm2 = Instance.new("SpecialMesh")
	dm2.MeshType = Enum.MeshType.Sphere
	dm2.Parent = bl
	dm2.Scale = Vector3.new(1.2, 1.2, 1.2)

	fWeld(
		"weld",
		t2,
		t2,
		bl,
		true,
		-0.5,
		0.5,
		-0.6,
		0,
		0,
		0
	)

	local br = Instance.new("Part")
	br.Name = "brazil"
	br.TopSurface = 0
	br.BottomSurface = 0
	br.CanCollide = false
	br.BrickColor = BrickColor.new("Pastel brown")
	br.Shape = Enum.PartType.Ball
	br.Parent = t2
	br.Size = Vector3.new(1, 1, 1)
	br.Massless = true

	local dm3 = Instance.new("SpecialMesh")
	dm3.MeshType = Enum.MeshType.Sphere
	dm3.Parent = br
	dm3.Scale = Vector3.new(1.2, 1.2, 1.2)

	fWeld(
		"weld",
		t2,
		t2,
		br,
		true,
		0.5,
		0.5,
		-0.6,
		0,
		0,
		0
	)

	local bln = Instance.new("Part")
	bln.Name = "burn1"
	bln.TopSurface = 0
	bln.BottomSurface = 0
	bln.CanCollide = false
	bln.BrickColor = BrickColor.new("Pink")
	bln.Shape = Enum.PartType.Ball
	bln.Parent = t2
	bln.Size = Vector3.new(1, 1, 1)
	bln.Massless = true

	local dm4 = Instance.new("SpecialMesh")
	dm4.MeshType = Enum.MeshType.Sphere
	dm4.Parent = bln
	dm4.Scale = Vector3.new(0.2, 0.2, 0.2)

	fWeld(
		"weld",
		t2,
		t2,
		bln,
		true,
		-0.5,
		0.5,
		-1.2,
		0,
		0,
		0
	)

	local brn = Instance.new("Part")
	brn.Name = "tester2"
	brn.TopSurface = 0
	brn.BottomSurface = 0
	brn.CanCollide = false
	brn.BrickColor = BrickColor.new("Pink")
	brn.Shape = Enum.PartType.Ball
	brn.Parent = t2
	brn.Size = Vector3.new(1, 1, 1)
	brn.Massless = true

	local dm5 = Instance.new("SpecialMesh")
	dm5.MeshType = Enum.MeshType.Sphere
	dm5.Parent = brn
	dm5.Scale = Vector3.new(0.2, 0.2, 0.2)

	fWeld(
		"weld",
		t2,
		t2,
		brn,
		true,
		0.5,
		0.5,
		-1.2,
		0,
		0,
		0
	)

	lh2.C1 =
		CFrame.new(0, -1.5, -0.5) *
		CFrame.Angles(0.9, -0.4, 0)

	rh2.C1 =
		CFrame.new(0, -1.5, -0.5) *
		CFrame.Angles(0.9, 0.4, 0)

	ls2.C1 =
		CFrame.new(-0.5, -1.3, -0.5) *
		CFrame.Angles(0.9, -0.4, 0)

	rs2.C1 =
		CFrame.new(0.5, -1.3, -0.5) *
		CFrame.Angles(0.9, 0.4, 0)

	local oldWeld = t1:FindFirstChild("weldx")

	if oldWeld then
		oldWeld:Destroy()
	end

	local we = fWeld(
		"weldx",
		t1,
		t1,
		t2,
		true,
		0,
		-0.9,
		-1.3,
		math.rad(-90),
		0,
		0
	)

	local n = t2:FindFirstChild("Neck")

	if n then
		n.C0 =
			CFrame.new(0, 1.5, 0) *
			CFrame.Angles(
				math.rad(-210),
				math.rad(180),
				0
			)
	end

	task.spawn(function()
		while we and we.Parent do
			for i = 1, 6 do
				if not we or not we.Parent then
					return
				end

				we.C1 = we.C1 * CFrame.new(0, -0.3, 0)
				task.wait()
			end

			for i = 1, 6 do
				if not we or not we.Parent then
					return
				end

				we.C1 = we.C1 * CFrame.new(0, 0.3, 0)
				task.wait()
			end
		end
	end)
end

local function getTargets()
	local targets = {}

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player and target.Character then
			table.insert(targets, {
				Name = target.Name,
				Model = target.Character,
				Type = "PLAYER"
			})
		end
	end

	for _, model in ipairs(workspace:GetChildren()) do
		if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") then
			local isPlayerCharacter = false

			for _, target in ipairs(Players:GetPlayers()) do
				if target.Character == model then
					isPlayerCharacter = true
					break
				end
			end

			if not isPlayerCharacter and model ~= player.Character then
				table.insert(targets, {
					Name = model.Name,
					Model = model,
					Type = "NPC"
				})
			end
		end
	end

	return targets
end

local function createGui()
	if gui then
		gui:Destroy()
	end

	gui = Instance.new("ScreenGui")
	gui.Name = "SignPlayerSelector"
	gui.ResetOnSpawn = false
	gui.Parent = playerGui

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 320, 0, 430)
	frame.Position = UDim2.new(0.5, -160, 0.5, -215)
	frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	frame.BorderSizePixel = 0
	frame.Parent = gui

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -55, 0, 55)
	title.Position = UDim2.new(0, 0, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = "SELECT PLAYER / NPC"
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextScaled = true
	title.Parent = frame

	local close = Instance.new("TextButton")
	close.Size = UDim2.new(0, 40, 0, 40)
	close.Position = UDim2.new(1, -45, 0, 7)
	close.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	close.Text = "X"
	close.TextColor3 = Color3.new(1, 1, 1)
	close.TextScaled = true
	close.Parent = frame

	close.Activated:Connect(function()
		if gui then
			gui:Destroy()
			gui = nil
		end
	end)

	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, -20, 1, -70)
	list.Position = UDim2.new(0, 10, 0, 60)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 7
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.Parent = frame

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 5)
	layout.Parent = list

	local targets = getTargets()

	for _, target in ipairs(targets) do
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, -5, 0, 45)
		button.BackgroundColor3 = target.Type == "NPC"
			and Color3.fromRGB(75, 55, 95)
			or Color3.fromRGB(55, 55, 55)

		button.TextColor3 = Color3.new(1, 1, 1)
		button.Text = target.Type == "NPC"
			and "[NPC] " .. target.Name
			or "[PLAYER] " .. target.Name

		button.TextScaled = true
		button.Parent = list

		button.Activated:Connect(function()
			if player.Character and target.Model and target.Model.Parent then
				fun(player.Name, target.Model.Name)
			end

			if gui then
				gui:Destroy()
				gui = nil
			end
		end)
	end

	task.wait()

	list.CanvasSize = UDim2.new(
		0,
		0,
		0,
		layout.AbsoluteContentSize.Y + 10
	)
end

tool.Equipped:Connect(function()
	createGui()
end)

tool.Unequipped:Connect(function()
	if gui then
		gui:Destroy()
		gui = nil
	end
end)

player.CharacterAdded:Connect(function()
	task.wait(1)

	if tool.Parent ~= backpack and tool.Parent ~= player.Character then
		tool.Parent = backpack
	end
end)
