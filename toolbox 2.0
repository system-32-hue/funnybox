local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = results

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 8)
padding.PaddingBottom = UDim.new(0, 8)
padding.PaddingLeft = UDim.new(0, 8)
padding.PaddingRight = UDim.new(0, 8)
padding.Parent = results

local function updateCanvas()
    results.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
end

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)

local function clearResults()
    for _, child in ipairs(results:GetChildren()) do
        if child:IsA("GuiObject") and child ~= layout and child ~= padding then
            child:Destroy()
        end
    end
end

local function status(text)
    clearResults()

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 90)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.TextSize = 14
    label.Font = Enum.Font.Gotham
    label.TextWrapped = true
    label.Text = text
    label.Parent = results

    updateCanvas()
end

-- Função para inserir asset
local function insertAsset(assetId)
    assetId = tonumber(assetId)

    if not assetId then
        status("ID inválido.")
        return
    end

    status("Carregando " .. assetId .. "...")

    -- Carregar no cliente (executor roda no cliente)
    local success, objects = pcall(function()
        local model = InsertService:LoadAsset(assetId)
        local container = {}
        for _, obj in ipairs(model:GetChildren()) do
            table.insert(container, obj)
        end
        model:Destroy()
        return container
    end)

    if not success or not objects or #objects == 0 then
        status("Falha ao carregar o modelo.\n\nID: " .. assetId)
        return
    end

    -- Enviar objetos para o servidor spawnar para TODOS
    remoteEvent:FireServer(objects)
    
    status("✓ Asset " .. assetId .. " spawnado para TODOS!")
end

local function createResult(assetId, assetName, creatorName, order)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 100)
    frame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    frame.LayoutOrder = order
