    frameCorner.Parent = frame

    local thumbnail = Instance.new("ImageLabel")
    thumbnail.Size = UDim2.new(0, 80, 0, 80)
    thumbnail.Position = UDim2.new(0, 8, 0, 10)
    thumbnail.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    thumbnail.ScaleType = Enum.ScaleType.Fit
    thumbnail.Image = "rbxthumb://type=Asset&id=" .. tostring(assetId) .. "&w=150&h=150"
    thumbnail.Parent = frame

    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(0, 6)
    thumbCorner.Parent = thumbnail

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -180, 0, 28)
    nameLabel.Position = UDim2.new(0, 98, 0, 10)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.new(1, 1, 1)
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    nameLabel.Text = assetName or "Modelo"
    nameLabel.Parent = frame

    local creatorLabel = Instance.new("TextLabel")
    creatorLabel.Size = UDim2.new(1, -180, 0, 20)
    creatorLabel.Position = UDim2.new(0, 98, 0, 38)
    creatorLabel.BackgroundTransparency = 1
    creatorLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
    creatorLabel.TextXAlignment = Enum.TextXAlignment.Left
    creatorLabel.TextSize = 12
    creatorLabel.Font = Enum.Font.Gotham
    creatorLabel.Text = "Criador: " .. tostring(creatorName or "?")
    creatorLabel.Parent = frame

    local idLabel = Instance.new("TextLabel")
    idLabel.Size = UDim2.new(1, -180, 0, 18)
    idLabel.Position = UDim2.new(0, 98, 0, 58)
    idLabel.BackgroundTransparency = 1
    idLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
    idLabel.TextXAlignment = Enum.TextXAlignment.Left
    idLabel.TextSize = 11
    idLabel.Font = Enum.Font.Gotham
    idLabel.Text = "ID: " .. tostring(assetId)
    idLabel.Parent = frame

    local insertButton = Instance.new("TextButton")
    insertButton.Size = UDim2.new(0, 70, 0, 28)
    insertButton.Position = UDim2.new(1, -80, 1, -36)
    insertButton.BackgroundColor3 = Color3.fromRGB(70, 130, 70)
    insertButton.TextColor3 = Color3.new(1, 1, 1)
    insertButton.Text = "Inserir"
    insertButton.TextSize = 13
    insertButton.Font = Enum.Font.GothamBold
    insertButton.Parent = frame

    local insertCorner = Instance.new("UICorner")
    insertCorner.CornerRadius = UDim.new(0, 6)
    insertCorner.Parent = insertButton

    insertButton.MouseButton1Click:Connect(function()
        insertAsset(assetId)
    end)
end

local function searchAssets()
    local query = search.Text:gsub("^%s+", ""):gsub("%s+$", "")

    if query == "" then
        status("Digite um nome ou um Asset ID.")
        return
    end

    if tonumber(query) then
        insertAsset(query)
        return
    end

    clearResults()
    status("Pesquisando...")

    -- Usar API de busca rápida
    local success, response = pcall(function()
        local url = "https://catalog.roblox.com/v1/search/items/details?Category=3&Limit=10&Query=" .. HttpService:UrlEncode(query)
        return HttpService:GetAsync(url)
    end)

    if success and response then
        local data = HttpService:JSONDecode(response)
        local list = data.data or {}
        
        if #list == 0 then
            status("Nenhum modelo encontrado.")
            return
        end

        clearResults()

        for i, asset in ipairs(list) do
            local id = asset.id
            local name = asset.name
            local creator = asset.creator and asset.creator.name or "?"
            
            if id then
                createResult(id, name, creator, i)
            end
        end

        updateCanvas()
    else
        -- Fallback para InsertService
        local success2, pages = pcall(function()
            return InsertService:GetFreeModels(query, 0)
        end)

        if not success2 or not pages then
            status("Erro na pesquisa.")
            return
        end

        local list = pages
        if typeof(pages) == "table" and pages[1] and pages[1].Results then
            list = pages[1].Results
        end

        if not list or #list == 0 then
            status("Nenhum modelo encontrado.")
            return
        end

        clearResults()

        for i, asset in ipairs(list) do
            local id = asset.AssetId or asset.Id or asset.AssetID
            local name = asset.Name or "Modelo"
            local creator = (asset.Creator and asset.Creator.Name) or asset.CreatorName or "?"

            if id then
                createResult(id, name, creator, i)
            end
        end

        updateCanvas()
    end
end

-- Conexões
openBtn.MouseButton1Click:Connect(function()
    main.Visible = not main.Visible
end)

searchButton.MouseButton1Click:Connect(searchAssets)

search.FocusLost:Connect(function(enter)
    if enter then
        searchAssets()
    end
end)

status("Pronto! Cole um Asset ID ou pesquise.")
