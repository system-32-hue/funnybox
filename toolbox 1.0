layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = results

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 8)
padding.PaddingBottom = UDim.new(0, 8)
padding.PaddingLeft = UDim.new(0, 8)
padding.PaddingRight = UDim.new(0, 8)
padding.Parent = results

local function updateCanvas()
    results.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
end

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)

local function clearResults()
    for _, child in ipairs(results:GetChildren()) do
        if child:IsA("GuiObject") and child ~= layout and child ~= padding then
            child:Destroy()
        end
    end
end

local function status(text)
    clearResults()

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 90)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.TextSize = 14
    label.Font = Enum.Font.Gotham
    label.TextWrapped = true
    label.Text = text
    label.Parent = results

    updateCanvas()
end

local function getSpawnCFrame()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if root then
        return root.CFrame * CFrame.new(0, 0, -12)
    end

    return CFrame.new(0, 5, 0)
end

-- ============================================
-- FUNÇÕES PARA EXECUTAR SCRIPTS DOS MODELOS
-- ============================================

-- Função para criar ambiente completo para scripts
local function createScriptEnvironment(scriptObj)
    local env = {}
    
    -- Variáveis básicas
    env.game = game
    env.workspace = workspace
    env.Players = Players
    env.InsertService = InsertService
    env.RunService = RunService
    env.player = player
    env.script = scriptObj
    env.scriptObj = scriptObj
    
    -- Funções globais
    env.print = print
    env.warn = warn
    env.error = error
    env.pcall = pcall
    env.xpcall = xpcall
    env.wait = wait
    env.task = task
    env.tick = tick
    env.time = time
    env.require = require
    env.loadstring = loadstring
    env.getfenv = getfenv
    env.setfenv = setfenv
    env.getmetatable = getmetatable
    env.setmetatable = setmetatable
    env.rawequal = rawequal
    env.rawget = rawget
    env.rawset = rawset
    env.tonumber = tonumber
    env.tostring = tostring
    env.type = type
    env.typeof = typeof
    env.pairs = pairs
    env.ipairs = ipairs
    env.next = next
    env.select = select
    env.unpack = unpack
    env.newproxy = newproxy
    env._G = _G
    env._VERSION = _VERSION
    
    -- Tipos
    env.Vector3 = Vector3
    env.CFrame = CFrame
    env.Color3 = Color3
    env.UDim2 = UDim2
    env.UDim = UDim
    env.Instance = Instance
    env.Enum = Enum
    env.math = math
    env.string = string
    env.table = table
    env.os = os
    env.coroutine = coroutine
    
    -- Serviços comuns
    local services = {
        "ReplicatedStorage",
        "ServerScriptService",
        "ServerStorage",
        "Lighting",
        "SoundService",
        "Debris",
        "TweenService",
        "PhysicsService",
        "CollectionService",
        "ContextActionService",
        "GuiService",
        "UserInputService",
        "StarterGui",
        "StarterPack",
        "Teams",
        "Chat",
        "MarketplaceService",
        "TeleportService",
        "BadgeService",
        "GamePassService",
        "Workspace",
        "Players",
        "InsertService",
        "RunService",
        "HttpService",
        "DataStoreService",
        "MemoryStoreService",
        "MessagingService"
    }
    
    for _, serviceName in ipairs(services) do
        pcall(function()
            local service = game:GetService(serviceName)
            if service then
                env[serviceName] = service
            end
        end)
    end
    
    return env
end

-- Função para executar um script individual
local function executeSingleScript(source, scriptObj)
    if not source or source == "" then
        return false, "Script vazio"
    end
    
    -- Compilar
    local func, compileErr = loadstring(source)
    if not func then
        return false, "Erro de compilação: " .. tostring(compileErr)
    end
    
    -- Criar ambiente
    local env = createScriptEnvironment(scriptObj)
    
    -- Configurar ambiente
    setfenv(func, env)
    
    -- Executar
    local success, err = pcall(func)
    if not success then
        return false, "Erro de execução: " .. tostring(err)
    end
    
    return true, nil
end

-- Função para executar todos os scripts de um container
local function executeAllScripts(container)
    local totalExecuted = 0
    local errors = {}
    
    -- Coletar todos os scripts
    local scripts = {}
    local localScripts = {}
    
    for _, obj in ipairs(container:GetDescendants()) do
        if obj:IsA("Script") then
            table.insert(scripts, obj)
        elseif obj:IsA("LocalScript") then
            table.insert(localScripts, obj)
        end
    end
    
    -- Executar Scripts (server-side)
    for _, scriptObj in ipairs(scripts) do
        pcall(function()
            -- Método 1: Ativar script
            scriptObj.Disabled = true
            task.wait(0.05)
            scriptObj.Disabled = false
            
            -- Método 2: Executar código diretamente
            local success, err = executeSingleScript(scriptObj.Source, scriptObj)
            if success then
                totalExecuted = totalExecuted + 1
                print("[Toolbox] Script executado:", scriptObj.Name)
            else
                table.insert(errors, scriptObj.Name .. ": " .. tostring(err))
                print("[Toolbox] Erro no script:", scriptObj.Name, "-", err)
            end
        end)
    end
    
    -- Executar LocalScripts (client-side)
    for _, scriptObj in ipairs(localScripts) do
        pcall(function()
            -- Clonar para PlayerGui
            local clone = scriptObj:Clone()
            clone.Disabled = true
            clone.Parent = player:WaitForChild("PlayerGui")
            
            -- Executar código
            local success, err = executeSingleScript(scriptObj.Source, clone)
            if success then
                totalExecuted = totalExecuted + 1
                print("[Toolbox] LocalScript executado:", scriptObj.Name)
            else
                table.insert(errors, scriptObj.Name .. ": " .. tostring(err))
                print("[Toolbox] Erro no LocalScript:", scriptObj.Name, "-", err)
            end
            
            -- Ativar clone
            clone.Disabled = false
        end)
    end
    
    return totalExecuted, errors
end

-- Função para executar scripts de ferramentas
local function executeToolScripts(tool)
    local executed = 0
    
    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") then
            pcall(function()
                local success = executeSingleScript(obj.Source, obj)
                if success then
                    executed = executed + 1
                    print("[Toolbox] Script da ferramenta executado:", obj.Name)
                end
            end)
        end
    end
    
    return executed
end

-- Função para forçar execução de todos os scripts possíveis
local function forceExecuteAll(model)
    local total = 0
    local errors = {}
    
    -- Executar scripts do modelo
    local modelScripts, modelErrors = executeAllScripts(model)
    total = total + modelScripts
    for _, err in ipairs(modelErrors) do
        table.insert(errors, err)
    end
    
    -- Executar scripts de ferramentas
    for _, tool in ipairs(model:GetDescendants()) do
        if tool:IsA("Tool") then
            local toolScripts = executeToolScripts(tool)
            total = total + toolScripts
        end
    end
    
    return total, errors
end

-- ============================================
-- FUNÇÕES ORIGINAIS MODIFICADAS
-- ============================================

local function moveToolsToBackpack(container)
    local backpack = player:WaitForChild("Backpack")
    local tools = {}

    for _, obj in ipairs(container:GetDescendants()) do
        if obj:IsA("Tool") then
            table.insert(tools, obj)
        end
    end

    for _, tool in ipairs(tools) do
        local handle = tool:FindFirstChild("Handle")

        if tool.RequiresHandle then
            if handle and handle:IsA("BasePart") then
                handle.Anchored = false
                handle.CanCollide = false
                handle.Massless = true
            else
                tool.RequiresHandle = false
            end
        end

        tool.Parent = backpack
        
        -- Executar scripts da ferramenta
        pcall(function()
            executeToolScripts(tool)
        end)
    end

    return #tools
end

local function prepareNormalObject(obj, spawnCF)
    if obj:IsA("Model") then
        pcall(function()
            obj:PivotTo(spawnCF)
        end)

    elseif obj:IsA("BasePart") then
        obj.CFrame = spawnCF
    end
end

local function insertAsset(assetId)
    assetId = tonumber(assetId)

    if not assetId then
        status("ID inválido.")
        return
    end

    status("Carregando modelo " .. assetId .. "...")

    local success, model = pcall(function()
        return InsertService:LoadAsset(assetId)
    end)

    if not success or not model then
        success, model = pcall(function()
            local objects = game:GetObjects("rbxassetid://" .. assetId)

            if objects and objects[1] then
                local container = Instance.new("Model")

                for _, obj in ipairs(objects) do
                    obj.Parent = container
                end

                return container
            end

            return nil
        end)
    end

    if not success or not model then
        status(
            "Falha ao carregar o modelo.\n\nID: "
                .. assetId
                .. "\n\nPossíveis causas:\n"
                .. "• Modelo não é gratuito\n"
                .. "• Modelo privado\n"
                .. "• Asset bloqueado"
        )
        return
    end

    -- DEBUG: Mostrar scripts encontrados
    local scriptCount = 0
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("LuaSourceContainer") then
            scriptCount = scriptCount + 1
            print("[DEBUG] Script encontrado:", obj.Name, obj.ClassName)
        end
    end
    print("[DEBUG] Total de scripts no modelo:", scriptCount)

    -- EXECUTAR TODOS OS SCRIPTS DO MODELO
    local totalScripts, scriptErrors = forceExecuteAll(model)

    local spawnCF = getSpawnCFrame()
    local toolCount = moveToolsToBackpack(model)

    local normalObjects = {}

    for _, obj in ipairs(model:GetChildren()) do
        if not obj:IsA("Tool") then
            table.insert(normalObjects, obj)
        end
    end

    for _, obj in ipairs(normalObjects) do
        obj.Parent = workspace
        prepareNormalObject(obj, spawnCF)
        
        -- Executar scripts nos objetos individuais
        pcall(function()
            local objScripts = executeAllScripts(obj)
            totalScripts = totalScripts + objScripts
        end)
    end

    model:Destroy()

    -- Status com informações
    local scriptInfo = "\n\nScripts executados: " .. totalScripts
    
    if #scriptErrors > 0 then
        scriptInfo = scriptInfo .. "\nErros: " .. #scriptErrors
    end

    if toolCount > 0 and #normalObjects > 0 then
        status(
            "Asset inserido!\n\n"
                .. toolCount
                .. " Tool(s) foram colocadas no Backpack.\n"
                .. "O restante do modelo foi colocado no Workspace."
                .. scriptInfo
                .. "\n\nID: "
                .. assetId
        )
    elseif toolCount > 0 then
        status(
            toolCount
                .. " Tool(s) inseridas no Backpack!"
                .. scriptInfo
                .. "\n\nID: "
                .. assetId
        )
    else
        status("Modelo inserido!" .. scriptInfo .. "\n\nID: " .. assetId)
    end
end

